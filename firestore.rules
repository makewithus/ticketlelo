rules_version = '2';

// ===============================================================
// TicketLelo — Production Security Rules
// ===============================================================
// Assumed Data Models & Access Summary:
// - users: Private user profile, role, phone, and payout details. Owner read/create/update (role protected), SuperAdmin all.
// - organizations: Organizer collectives/organizations. Public read, members update, SuperAdmin delete.
// - events: Public event listings. Managed by creator / assigned organiser / organization members / SuperAdmin.
// - subEvents: Public schedule / track / workshop items. Managed by Organisers / SuperAdmin.
// - combos: Public combo tickets and fest passes. Managed by Organisers / SuperAdmin.
// - registrations: Client registration intake (restricted fields, pending status). Read by attendee / organiser / SuperAdmin.
// - reservations: Ticket reservations / seat holds. SuperAdmin writes only.
// - orders: Payment / ticketing orders. SuperAdmin writes only.
// - tickets: Issued tickets with QR signatures. SuperAdmin writes only (Admin SDK).
// - payments: Financial payment tracking records. SuperAdmin writes only.
// - ambassadorPrograms: Campus ambassador campaigns. Public read, Organisers manage.
// - ambassadors: Ambassador profile & tracking. Read by owner / organiser / SuperAdmin.
// - commissions & ambassadorCommissions: Ambassador commissions ledger. Read by ambassador / organiser / SuperAdmin.
// - payoutBatches: Payout batch approvals. Organisers and SuperAdmin.
// - certificates: Verification metadata public; PII protected to recipient / organiser / SuperAdmin (DEF-022).
// - merchandise: Creator store items. Public read, Organiser/SuperAdmin write.
// - hostingRequests: Organiser applications. Public create, requester / organiser / SuperAdmin read.
// - customForms: Registration custom forms. Public read, Organisers manage.
// - coupons: Discount & promo codes. Public read, Organisers manage.
// - messages & messageReceipts: Event notification messages & delivery receipts. Organisers manage.
// - plans & planOrders: Pricing plans and subscriptions. SuperAdmin manage.
// - analytics: Event analytics aggregates. Organiser / SuperAdmin read.
// - supportTickets: Support inquiries. Organizer reads own, SuperAdmin reads/writes all.
// - cancellationRequests: Event cancellation workflows. Organizer reads/creates own, SuperAdmin reads/writes all.
// - siteSettings: Platform configuration. Public read for homepage, countdown, general. SuperAdmin writes all.
// - Internal financial & server collections: settlements, connectedAccounts, counters, ledgerEntries,
//   financialAuditLogs, offlineScanSyncs, paymentRefunds, paymentSplits, marketplaceCommissions,
//   emailJobs, emailQuotaLedger, emailSuppression, scheduledJobs, webhookEvents, passwordResetCodes. SuperAdmin only.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== Helper Functions =====
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == "superAdmin") ||
        (request.auth.token.admin == true) ||
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email.lower() == "adil4ticketlelo@gmail.com" ||
          request.auth.token.email.lower() == "superadmin@ticketlelo.com" ||
          request.auth.token.email.matches("(?i)^(adil4ticketlelo@gmail\\.com|superadmin@ticketlelo\\.com)$")
        )) ||
        (request.auth.token.email == "adil4ticketlelo@gmail.com") ||
        (request.auth.token.email == "superadmin@ticketlelo.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "superAdmin"
        ))
      );
    }
    
    function isOrganiser() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.token.role == "organiser") ||
        (request.auth.token.role == "organizer") ||
        (request.auth.token.role == "superAdmin") ||
        (request.auth.token.admin == true) ||
        ('isAdmin' in request.auth.token && request.auth.token.isAdmin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "organiser" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "organizer" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == "superAdmin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
        ))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isOrgMember(orgId) {
      return isAuthenticated() &&
             (isSuperAdmin() ||
              (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
               request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.get('members', [])));
    }

    function managesEventData(data) {
      return isSuperAdmin() || 
             (isAuthenticated() && (
               (data.get('createdBy', '') == request.auth.uid) ||
               (data.get('userId', '') == request.auth.uid) ||
               (data.get('organiserId', '') == request.auth.uid) ||
               (data.get('organizerId', '') == request.auth.uid) ||
               (data.get('creatorId', '') == request.auth.uid) ||
               (isOrganiser() && (
                 (data.get('createdBy', '') == request.auth.uid) ||
                 (data.get('userId', '') == request.auth.uid) ||
                 (data.get('organiserId', '') == request.auth.uid) ||
                 (data.get('organizerId', '') == request.auth.uid) ||
                 (data.get('creatorId', '') == request.auth.uid) ||
                 (data.get('organizationId', '') != '' && isOrgMember(data.organizationId)) ||
                 ('email' in request.auth.token && request.auth.token.email != null && (
                   (data.get('organiserEmail', '') != '' && data.organiserEmail.lower() == request.auth.token.email.lower()) ||
                   (data.get('organizerEmail', '') != '' && data.organizerEmail.lower() == request.auth.token.email.lower()) ||
                   (data.get('email', '') != '' && data.email.lower() == request.auth.token.email.lower())
                 ))
               ))
             ));
    }

    // ===== Users Collection =====
    match /users/{userId} {
      // Profiles contain private contact and payout details. Event staff use
      // event-scoped registration records instead of enumerating user profiles.
      allow read: if isOwner(userId) || isSuperAdmin();
      
      // User can create their own document on signup
      allow create: if isOwner(userId) && 
                       (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == "user") &&
                       (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false) &&
                       !request.resource.data.keys().hasAny(['eventsAllowed', 'organizationId']);
      
      // User can update their own profile, but cannot tamper with role, admin privileges, or organization
      allow update: if (isOwner(userId) && 
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'eventsAllowed', 'organizationId'])) ||
                       isSuperAdmin();
      
      // Only SuperAdmin can delete user records
      allow delete: if isSuperAdmin();
    }

    // ===== Organizations Collection =====
    match /organizations/{orgId} {
      // Public can read basic organization info (name, slug, logo)
      allow read: if true;
      // Organisers and SuperAdmin can create organizations
      allow create: if isOrganiser() || isSuperAdmin();
      // Only organization members or SuperAdmin can update
      allow update: if isOrgMember(orgId) || isSuperAdmin();
      // Only SuperAdmin or organization owner can delete
      allow delete: if isSuperAdmin();
    }
    
    // ===== Major Events Collection =====
    match /events/{eventId} {
      // Anyone can read events (attendees viewing tickets, public festival listings)
      allow read: if true;
      // Organisers, Super Admins, and authenticated creators can create and manage events
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isOrganiser() ||
        request.resource.data.get('createdBy', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('organiserId', '') == request.auth.uid ||
        request.resource.data.get('organizerId', '') == request.auth.uid ||
        request.resource.data.get('creatorId', '') == request.auth.uid
      );
      allow update: if (
        isSuperAdmin() ||
        managesEventData(resource.data) ||
        (isAuthenticated() && (
          resource.data.get('createdBy', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('organiserId', '') == request.auth.uid ||
          resource.data.get('organizerId', '') == request.auth.uid ||
          resource.data.get('creatorId', '') == request.auth.uid
        ))
      ) && (
        isSuperAdmin() ||
        // Ensure ownership cannot be reassigned to a different user on update
        (request.resource.data.get('createdBy', resource.data.get('createdBy', '')) in [resource.data.get('createdBy', ''), request.auth.uid])
      );
      allow delete: if isSuperAdmin() || managesEventData(resource.data) || (isAuthenticated() && (
        resource.data.get('createdBy', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('organiserId', '') == request.auth.uid ||
        resource.data.get('organizerId', '') == request.auth.uid ||
        resource.data.get('creatorId', '') == request.auth.uid
      ));
    }

    // ===== Sub-Events Collection =====
    match /subEvents/{subEventId} {
      // Anyone can read public sub-events for tracks, workshops, and scheduling
      allow read: if true;
      // Organisers and Super Admins can manage sub-events
      allow write: if isOrganiser() || isSuperAdmin();
    }

    // ===== Combo Tickets & Fest Passes =====
    match /combos/{comboId} {
      // Anyone can read active combos for ticketing selection
      allow read: if true;
      // Organisers and Super Admins can manage combos
      allow write: if isOrganiser() || isSuperAdmin();
    }

    // ===== Registrations Collection =====
    match /registrations/{registrationId} {
      // Attendees can read their own registrations; Organisers and Super Admins can read registrations for their events
      allow read: if isAuthenticated() && 
                     (request.auth.uid == resource.data.get('userId', '') || 
                      ('email' in request.auth.token && (
                        request.auth.token.email == resource.data.get('email', '') ||
                        request.auth.token.email == resource.data.get('buyerEmail', '')
                      )) ||
                      isOrganiser() || 
                      isSuperAdmin());
      
      // Clients may submit intake only. Ticket IDs, QR payloads, free/paid state,
      // entitlements and admission state are issued by trusted server routes.
      allow create: if isAuthenticated() &&
                       (isSuperAdmin() || (
                         request.auth.uid == request.resource.data.userId &&
                         request.resource.data.keys().hasOnly([
                           'userId', 'eventId', 'fullName', 'email', 'whatsappPhone',
                           'customFieldResponses', 'formData', 'status', 'paymentStatus', 'createdAt'
                         ]) &&
                         request.resource.data.status == 'pending' &&
                         request.resource.data.paymentStatus == 'pending'
                       ));
      
      // Updates are restricted to organisers or SuperAdmin, or attendee updating their own
      allow update: if isOrganiser() || isSuperAdmin() || (isAuthenticated() && request.auth.uid == resource.data.get('userId', ''));
      allow delete: if isOrganiser() || isSuperAdmin();
    }

    // ===== Reservations Collection =====
    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.get('userId', '') || isOrganiser() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ===== Orders Collection =====
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.get('userId', '') || isOrganiser() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ===== Tickets Collection =====
    match /tickets/{ticketId} {
      // Attendees can read their own tickets; Organisers and SuperAdmin can read tickets for gate operations
      allow read: if isAuthenticated() && 
                     (request.auth.uid == resource.data.get('userId', '') || 
                      ('email' in request.auth.token && request.auth.token.email == resource.data.get('buyerEmail', '')) ||
                      isOrganiser() || 
                      isSuperAdmin());
      // Tickets are issued and updated exclusively via trusted server-side Admin SDK
      allow write: if isSuperAdmin();
    }
    
    // ===== Payments Collection =====
    match /payments/{paymentId} {
      // User can read their own payment records; Organisers and SuperAdmin can review payments
      allow read: if isAuthenticated() && 
                     (request.auth.uid == resource.data.get('userId', '') || isOrganiser() || isSuperAdmin());
      // Payments must be created and updated via trusted server-side API (Admin SDK)
      allow write: if isSuperAdmin();
    }

    // ===== Campus Ambassador Programs & Applications =====
    match /ambassadorPrograms/{programId} {
      allow read: if true;
      allow write: if isOrganiser() || isSuperAdmin();
    }

    match /ambassadors/{ambassadorId} {
      // Ambassadors can read their own record; Organisers and SuperAdmin can review all
      allow read: if isOwner(ambassadorId) || isOrganiser() || isSuperAdmin();
      // Public applicants can submit an ambassador application
      allow create: if isAuthenticated() && request.auth.uid == ambassadorId;
      // Only Organiser and SuperAdmin can approve/reject and edit ambassador status
      allow update, delete: if isOrganiser() || isSuperAdmin();
    }

    match /commissions/{commissionId} {
      // Ambassador can read their own commission ledger entries
      allow read: if isAuthenticated() && 
                     (request.auth.uid == resource.data.get('ambassadorId', '') || isOrganiser() || isSuperAdmin());
      // Only server-side or SuperAdmin can write ledger entries (immutable accounting)
      allow write: if isSuperAdmin();
    }

    match /ambassadorCommissions/{commissionId} {
      allow read: if isAuthenticated() && 
                     (request.auth.uid == resource.data.get('ambassadorId', '') || isOrganiser() || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /payoutBatches/{batchId} {
      allow read, write: if isOrganiser() || isSuperAdmin();
    }

    // ===== Dual-Level Certificates Collection =====
    match /certificates/{certId} {
      // DEF-022: Public verification page allows reading certificate metadata,
      // but private personal details (buyerEmail, attendeeEmail, phone) are restricted to owner attendee, organiser, or superAdmin.
      allow read: if (isAuthenticated() && (
                       (resource.data.keys().hasAny(['userId']) && request.auth.uid == resource.data.userId) ||
                       (resource.data.keys().hasAny(['buyerEmail']) && 'email' in request.auth.token && request.auth.token.email == resource.data.buyerEmail) ||
                       isOrganiser() ||
                       isSuperAdmin()
                     )) ||
                     !resource.data.keys().hasAny(['buyerEmail', 'attendeeEmail', 'phone']);
      // Creation and updates are strictly server-side / SuperAdmin
      allow write: if isOrganiser() || isSuperAdmin();
    }

    // ===== Creator Store / Merchandise =====
    match /merchandise/{merchId} {
      allow read: if true;
      allow write: if isOrganiser() || isSuperAdmin();
    }

    // ===== Hosting Requests =====
    match /hostingRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'eventTitle', 'status', 'createdAt']) || isAuthenticated();
      allow read: if isSuperAdmin() || isOrganiser() || (isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('organiserId', '') == request.auth.uid ||
        resource.data.get('createdBy', '') == request.auth.uid ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          (resource.data.get('email', '') != '' && resource.data.email.lower() == request.auth.token.email.lower()) ||
          (resource.data.get('userAccountEmail', '') != '' && resource.data.userAccountEmail.lower() == request.auth.token.email.lower()) ||
          resource.data.get('email', '') == request.auth.token.email ||
          resource.data.get('userAccountEmail', '') == request.auth.token.email
        ))
      ));
      allow update, delete: if isSuperAdmin() || isOrganiser();
    }
    
    // ===== Custom Forms =====
    match /customForms/{formId} {
      allow read: if true;
      allow create, update: if isOrganiser() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
    
    // ===== Coupons =====
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isOrganiser() || isSuperAdmin();
    }
    
    // ===== Messages & Receipts =====
    match /messages/{messageId} {
      allow read, write: if isOrganiser() || isSuperAdmin();
    }
    
    match /messageReceipts/{receiptId} {
      allow read: if isOrganiser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    
    // ===== Plans & Analytics =====
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /planOrders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.get('userId', '') || isSuperAdmin());
      allow write: if isSuperAdmin();
    }
    
    match /analytics/{analyticsId} {
      allow read: if isOrganiser() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ===== Support Tickets =====
    match /supportTickets/{ticketId} {
      // Organizers can read their own support tickets; Super Admin can read all
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('organiserId', '') == request.auth.uid ||
        resource.data.get('organizerId', '') == request.auth.uid ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          resource.data.get('organizerEmail', '') == request.auth.token.email ||
          resource.data.get('organizerEmail', '').lower() == request.auth.token.email.lower() ||
          resource.data.get('email', '') == request.auth.token.email ||
          resource.data.get('email', '').lower() == request.auth.token.email.lower()
        ))
      ));
      
      // Authenticated users/organizers can create tickets for themselves; Super Admin can create any
      allow create: if isSuperAdmin() || (isAuthenticated() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('organiserId', '') == request.auth.uid ||
        request.resource.data.get('organizerId', '') == request.auth.uid ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.resource.data.get('organizerEmail', '') == request.auth.token.email ||
          request.resource.data.get('email', '') == request.auth.token.email
        ))
      ));
      
      // All other mutations reserved exclusively for Super Admin or backend Admin SDK
      allow update, delete: if isSuperAdmin();

      // Support Ticket Messages subcollection
      match /messages/{messageId} {
        allow read: if isSuperAdmin() || (isAuthenticated() && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.get('userId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.get('organiserId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.get('organizerId', '') == request.auth.uid ||
          ('email' in request.auth.token && request.auth.token.email != null && (
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.get('organizerEmail', '') == request.auth.token.email ||
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.get('email', '') == request.auth.token.email
          ))
        ));
        allow write: if isSuperAdmin();
      }
    }

    // ===== Cancellation Requests =====
    match /cancellationRequests/{requestId} {
      // Organizers can read their own cancellation requests; Super Admin can read all
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('organiserId', '') == request.auth.uid ||
        resource.data.get('organizerId', '') == request.auth.uid ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          resource.data.get('organizerEmail', '') == request.auth.token.email ||
          resource.data.get('organizerEmail', '').lower() == request.auth.token.email.lower() ||
          resource.data.get('email', '') == request.auth.token.email ||
          resource.data.get('email', '').lower() == request.auth.token.email.lower()
        ))
      ));

      // Organizers can submit cancellation requests for their events
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isOrganiser() ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('organiserId', '') == request.auth.uid ||
        request.resource.data.get('organizerId', '') == request.auth.uid ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.resource.data.get('organizerEmail', '') == request.auth.token.email ||
          request.resource.data.get('email', '') == request.auth.token.email
        ))
      );

      // Status decisions and resolutions restricted to Super Admin
      allow update, delete: if isSuperAdmin();
    }

    // ===== Site Settings =====
    match /siteSettings/{settingId} {
      // Public read for published site settings (homepage, countdown, general)
      allow read: if (settingId in ['homepage', 'countdown', 'general']) || isSuperAdmin();
      // Settings updates restricted strictly to Super Admin
      allow write: if isSuperAdmin();
    }

    // ===== Event Publications Record =====
    match /eventPublications/{pubId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ===== Internal / Financial Ledger / Server Collections =====
    // Restricted strictly to SuperAdmin; Admin SDK handles server operations.
    // Client access is blocked to preserve financial immutability and security.
    match /settlements/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /connectedAccounts/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /counters/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /ledgerEntries/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /financialAuditLogs/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /offlineScanSyncs/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /paymentRefunds/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /paymentSplits/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /marketplaceCommissions/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /emailJobs/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /emailQuotaLedger/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /emailSuppression/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /scheduledJobs/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /webhookEvents/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /passwordResetCodes/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /accountSetupTokens/{docId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
