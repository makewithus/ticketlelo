# ==========================================
# TicketLelo Platform Environment Configuration
# TEMPLATE ONLY — NEVER COMMIT REAL SECRETS
# ==========================================

# Server Node Environment ("development" | "production" | "test")
NODE_ENV=development

# Web Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Admin SDK Configuration (Server-Only Trusted Operations)
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Razorpay Gateway Configuration
# Key ID is public to client during checkout; Key Secret is STRICTLY SERVER-ONLY
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Cryptographic QR Ticket Signing Secret (HMAC-SHA-256)
# MANDATORY in production — Server fails closed if missing
QR_SIGNING_SECRET=your_high_entropy_random_32_byte_secret_key_here

# Nodemailer / SMTP Email Configuration (Optional for Messaging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASS=your_app_specific_email_password
EMAIL_FROM=TicketLelo <notifications@yourdomain.com>

# Google Maps Platform (Optional - Client Map Embed)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_placeholder

# Google Sheets Sync (Optional - Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheet_id_here

# Meta WhatsApp Cloud API (Optional - Broadcast Messaging)
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Apple Wallet Pass Signing (Optional - .pkpass Generation)
APPLE_PASS_TYPE_IDENTIFIER=pass.com.ticketlelo.event
APPLE_TEAM_IDENTIFIER=your_apple_team_id_here
APPLE_PASS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
APPLE_PASS_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Google Wallet Passes (Optional - Event Ticket Issuer)
GOOGLE_WALLET_ISSUER_ID=your_google_wallet_issuer_id_here
GOOGLE_WALLET_SERVICE_ACCOUNT="{\"type\":\"service_account\",\"project_id\":\"...\"}"

